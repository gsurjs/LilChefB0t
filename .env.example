# ─────────────────────────────────────────────────────────────────────────────
#  Twitch application
#  Register at https://dev.twitch.tv/console/apps
#    OAuth Redirect URL : http://localhost     (required field, unused here)
#    Client Type        : Public               (recommended for `npm run auth`)
# ─────────────────────────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=

# Only needed if you registered a Confidential app. A Public app refreshes its
# tokens without a secret, so leave this blank for the normal setup.
TWITCH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
#  Accounts
#  There is no OAUTH_TOKEN any more. Run `npm run auth` once; tokens (with
#  refresh tokens) are written to data/tokens.json and renewed automatically.
# ─────────────────────────────────────────────────────────────────────────────
BOT_USERNAME=lilchefb0t
CHANNEL_NAME=roguedubz

# Comma-separated usernames allowed to run admin commands.
AUTHORIZED_USERS=roguedubz

# ─────────────────────────────────────────────────────────────────────────────
#  Claude  (https://platform.claude.com/settings/keys)
#  Billed to a Claude Console organization. On Max / Ultra / Team, your plan
#  includes monthly API credits that cover this bot -- claim them once at
#  claude.ai > Settings > Billing > API credits. Otherwise buy credits.
# ─────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# claude-sonnet-5-5  $2/$10 per MTok   ~$3.80 per 1,000 replies  (default)
# claude-haiku-5-5   $0.10/$0.50       ~$0.20 per 1,000 replies  (fastest, cheapest)
# claude-opus-5-5    $4/$20            ~$7.60 per 1,000 replies  (sharpest)
CLAUDE_MODEL=claude-sonnet-5-5

# low | medium | high. Chat wants speed, so low is the default.
# Higher levels are rejected alongside the low-latency thinking mode.
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=1024

# Hard daily ceiling in USD. Requests are refused past it until UTC midnight.
AI_DAILY_USD_CAP=2

AI_ENABLED=true
AI_COOLDOWN_MS=10000
AI_MEMORY_WINDOW=25

# Reply when chat says the bot's name, not just on !chefbot.
AI_RESPOND_TO_MENTIONS=true
AI_MENTION_COOLDOWN_MS=30000

# AI-written raid/sub/cheer shoutouts. Falls back to templates when off.
AI_EVENT_REACTIONS=true

# ─────────────────────────────────────────────────────────────────────────────
#  Channel links
# ─────────────────────────────────────────────────────────────────────────────
DISCORD_INVITE=
TWITTER_HANDLE=
YOUTUBE_CHANNEL=

# ─────────────────────────────────────────────────────────────────────────────
#  Runtime
# ─────────────────────────────────────────────────────────────────────────────
# Health endpoint. Point your host's health check at /healthz on this port.
PORT=3000

# debug | info | warn | error
LOG_LEVEL=info

AUTOPOST_ENABLED=false
AUTOPOST_INTERVAL_MS=600000
